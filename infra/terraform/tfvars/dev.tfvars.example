# infra/terraform/tfvars/dev.tfvars.example
#
# Copy to dev.tfvars and fill in values before running:
#   cp infra/terraform/tfvars/dev.tfvars.example infra/terraform/tfvars/dev.tfvars
#
# dev.tfvars is gitignored — never commit real values.

aws_region   = "us-west-2"
environment  = "dev"
project_name = "private-ai-workspace"

# VPC
vpc_cidr                  = "10.0.0.0/16"
enable_single_nat_gateway = true

# EKS
kubernetes_version = "1.35"

# Control-plane node group
control_plane_node_instance_types = ["m7i.large"]
control_plane_desired_size        = 1
control_plane_min_size            = 1
control_plane_max_size            = 2

# GPU inference node group (start cold in dev)
gpu_node_instance_types = ["g5.xlarge"]
gpu_desired_size        = 0
gpu_min_size            = 0
gpu_max_size            = 1
gpu_capacity_type       = "SPOT"

# RDS
postgres_version          = "16"
rds_instance_class        = "db.t3.medium"
rds_multi_az              = false
rds_backup_retention_days = 3

# Dev OIDC (Cognito) + UI TLS — the M9 product surface sign-in.
# enable_dev_cognito creates a Cognito user pool + public SPA client + hosted-UI
# domain. The hosted-UI domain prefix must be globally unique. ui_host drives the
# Cognito callback/logout URLs and the ACM certificate domain; acm_route53_zone_id
# is the hosted zone used to DNS-validate that certificate. Seed test users span
# two email domains (tenant identity = email domain); their passwords are set
# out-of-band, not in Terraform.
enable_dev_cognito              = true
cognito_hosted_ui_domain_prefix = "private-ai-dev-changeme"
# Seed users span two domains (tenant-a / tenant-b) for cross-tenant tests, plus
# a second tenant-a user (carol) for the M10 cross-user memory isolation probe.
cognito_test_user_emails        = ["alice@tenant-a.test", "bob@tenant-b.test", "carol@tenant-a.test"]
ui_host                         = "ai-dev.example.com"
acm_route53_zone_id             = "ZXXXXXXXXXXXXX"

{
  "id": null,
  "uid": "m10-retrieval-memory",
  "title": "Control Plane \u2014 Retrieval & Memory (M10)",
  "description": "Retrieval and per-user memory operations: throughput, latency, recall proxy, embedding throughput/latency, and index growth. Labels are operation names only (no tenant/user ids or content).",

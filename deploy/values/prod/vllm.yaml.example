# Example production vLLM overrides.
# Copy to prod/vllm.yaml and adjust for your environment; review with maintainers
# before deploying to a production cluster.
#
# See docs/09-scaling-policy.md for the policy this file implements.

replicaCount: 1                # Warm pool — always one ready replica.

image:
  tag: "v0.9.0"

model:
  id: "mistralai/Mistral-7B-Instruct-v0.3"
  dtype: "float16"
  maxModelLen: 8192
  tensorParallelSize: 1
  maxNumSeqs: 128

resources:
  requests:
    nvidia.com/gpu: 1
  limits:
    nvidia.com/gpu: 1

serviceAccount:
  create: true
  # Set from: terraform -chdir=infra/terraform output -raw irsa_vllm_role_arn
  irsaRoleArn: ""

externalSecrets:
  enabled: true
  awsRegion: us-east-1
  # Set from: terraform -chdir=infra/terraform output -raw hf_token_secret_name
  hfTokenSecretName: ""
  refreshInterval: "12h"

networkPolicy:
  enabled: true
  controlPlaneNamespace: app

# HPA — bursts up to 6 replicas (constrained by Karpenter NodePool maxGpus).
autoscaling:
  enabled: true
  minReplicas: 1
  maxReplicas: 6
  targetQueueDepth: 8

metrics:
  serviceMonitor:
    enabled: true
    additionalLabels:
      release: observability

# Protect the warm replica during node drains.
podDisruptionBudget:
  enabled: true
  minAvailable: 1

podAnnotations:
  prometheus.io/scrape: "true"
  prometheus.io/port: "8000"
  prometheus.io/path: "/metrics"
